# =============================================================================
# Amy Team Chatbot - .gitignore
# RAG-powered Assistant Coach for Amnesia Esports
# =============================================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
eggs/
*.whl

# ----- Virtual Environments -----
.venv/
venv/
ENV/

# ----- Environment Variables & Secrets -----
.env
.env.local
.env.production
credentials.json
token.json
service_account.json
*.key

# ----- AI Assistant & IDE Internal Artifacts -----
.agents/
.tmp/
.vscode/
.idea/
*.swp
*.swo
*~
test_engine.py

# ----- ChromaDB Persistent Storage (runtime generated) -----
chroma_db/
!chroma_db/.gitkeep

# ----- Source Documents (user-provided, not tracked) -----
data/*
!data/samples/

# ----- Docker -----
docker-compose.override.yml

# ----- OS Specific -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Testing & Code Quality -----
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ----- Logs & Diagnostics -----
*.log
*.bak
