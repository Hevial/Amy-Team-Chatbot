# =============================================================================
# Amy Team Chatbot - Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# --- Google AI Studio API Key (required) ---
# Groq API Key (Fast & Free Tier LLM)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# (Optional) Google API Key (if you want to switch back to Gemini)
GOOGLE_API_KEY=AIzaSy_your_google_api_key_here

# --- LLM Configuration ---
LLM_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-2

# --- Data & Storage Paths ---
DATA_DIR=./data/samples
CHROMA_DB_DIR=./chroma_db
COLLECTION_NAME=amnesia_docs

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# --- RAG Engine Settings ---
SIMILARITY_TOP_K=5
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
